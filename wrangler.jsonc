/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bebella-ecommerce",
	"main": "worker/server.ts",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		/* "directory": "./src",
		"binding": "ASSETS",*/
		"run_worker_first": [
			"/userapi/*",
			"/admin/*",
			"/items/*",
		]
	},
	"workers_dev": false,
	"preview_urls": false,
	"env": {
		"production": {
			"vars": {
				"CF_ENV": "production",
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"MongoDBConnection"
					]
				}
			],
			"routes": [
				{
					"pattern": "bebellaboutique.com",
					"custom_domain": true,
					"enabled": true,
				}
			],
			"observability": {
				"enabled": true
			},
			"upload_source_maps": true,
			"secrets_store_secrets": [
				{
					"binding": "ADMIN_FID",
					"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
					"secret_name": "ADMIN_FID"
				},
				{
					"binding": "DBPROD_URL",
					"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
					"secret_name": "DBPROD_URL"
				},
				{
					"binding": "JWT_SEC",
					"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
					"secret_name": "JWT_SEC"
				},
				{
					"binding": "MP_ACCESS",
					"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
					"secret_name": "MP_ACCESS"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "MONGODB_CONNECTION",
						"class_name": "MongoDBConnection"
					}
				]
			},
			"send_email": [
				{
					"name": "EMAIL",
					"remote": true
				}
			]
		},
		"dev": {
			"vars": {
				"CF_ENV": "dev",
			},
			"secrets": {
				"required": [
					"JWT_SEC",
					"DBPROD_URL",
					"MP_ACCESS",
					"ADMIN_FID"
				],
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "MONGODB_CONNECTION",
						"class_name": "MongoDBConnection"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_classes": [
						"MongoDBConnection"
					]
				}
			],
			"routes": [],
			"send_email": [
				{
					"name": "EMAIL",
					"remote": true
				}
			]
		}
	},
}
