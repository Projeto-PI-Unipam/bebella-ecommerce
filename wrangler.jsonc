/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudbella",
	"main": "worker/server.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"directory": "./src/assets",
		"binding": "ASSETS",
		"run_worker_first": [
			"/userapi/*",
			"/admin/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"secrets_store_secrets": [
		{
			"binding": "ADMIN_FID",
			"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
			"secret_name": "ADMIN_FID"
		},
		{
			"binding": "DBPROD_URL",
			"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
			"secret_name": "DBPROD_URL"
		},
		{
			"binding": "JWT_SEC",
			"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
			"secret_name": "JWT_SEC"
		},
		{
			"binding": "MP_ACCESS",
			"store_id": "a10e7e42edd64e718f68e8a2df4cc123",
			"secret_name": "MP_ACCESS"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MONGODB_CONNECTION",
				"class_name": "MongoDBConnection"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"MongoDBConnection"
			]
		}
	]
}
